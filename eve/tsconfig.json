{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "eve/workflow-modules"],
    "paths": { "@/*": ["../src/*"] }
  },
  "include": [
    "agent/**/*.ts",
    "../src/lib/eve-protocol.ts",
    "../src/lib/findings.ts",
    "../src/lib/github-app-auth.ts",
    "../src/lib/scanners.ts",
    "../src/lib/security-scans.ts"
  ]
}
