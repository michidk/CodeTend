# PostgreSQL. Use URL-escaped random values outside local development.
POSTGRES_PASSWORD=change-me-database-password
DATABASE_URL=postgresql://tecdebt:change-me-database-password@127.0.0.1:5432/tecdebt

# Where fresh repository checkouts and GitNexus indexes are created.
TECDEBT_DATA_DIR=./data

# The production server fails closed when this password is missing. HTTP Basic
# is suitable for a private single-tenant deployment behind TLS.
TECDEBT_BASIC_AUTH_USERNAME=tecdebt
TECDEBT_BASIC_AUTH_PASSWORD=change-me-app-password

# Clone boundary. Comma-separated exact hosts; local paths and plaintext HTTP
# remain disabled unless explicitly enabled for a trusted development host.
TECDEBT_ALLOWED_GIT_HOSTS=github.com
TECDEBT_ALLOW_LOCAL_REPOSITORIES=false
TECDEBT_ALLOW_INSECURE_GIT=false

# Cost and concurrency guardrails.
TECDEBT_MAX_ACTIVE_SCANS=2
TECDEBT_MAX_ACTIVE_PATCHES=1
# TECDEBT_MAX_DAILY_COST_USD=25
# TECDEBT_DEFAULT_SCAN_COST_USD=5
TECDEBT_MANUAL_SCAN_COOLDOWN_SECONDS=60

# Deep security discovery is bounded by workers, total runs, and convergence.
TECDEBT_DEEP_WORKERS=2
TECDEBT_DEEP_MAX_RUNS=6
TECDEBT_DEEP_STOP_AFTER_NO_NEW=2

# Optional executable finding validation. This requires Eve to have access to
# a Docker daemon. It never falls back to executing model-proposed commands on
# the host. Keep disabled in the bundled nested-container deployment.
TECDEBT_VALIDATION_ENABLED=false
TECDEBT_VALIDATION_RUNNER=auto
TECDEBT_VALIDATION_IMAGE=node:24-bookworm-slim

# Eve agent runtime (see eve/). The app calls it over HTTP.
EVE_URL=http://127.0.0.1:2000
EVE_USERNAME=tecdebt
EVE_PASSWORD=change-me

# Scheduler: how often the app looks for due repositories (seconds).
SCHEDULER_INTERVAL_SECONDS=30

# Model used by the Eve agents through an OpenAI-compatible endpoint. Point
# OPENAI_BASE_URL at a gateway such as OpenRouter to run other vendors' models
# (for example TECDEBT_MODEL=anthropic/claude-opus-5).
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com
# TECDEBT_MODEL=gpt-5.6-sol
# Reasoning effort: low, medium, high, xhigh or max. Defaults to medium for
# GPT models and high for Claude models.
# TECDEBT_EFFORT=
# Context window of the configured model in tokens (default 1050000).
# TECDEBT_MODEL_CONTEXT_WINDOW_TOKENS=
TECDEBT_MAX_INPUT_TOKENS_PER_SESSION=250000
TECDEBT_SCANNER_CONCURRENCY=4

# Optional short-lived GitHub App installation token for private HTTPS clones.
# GITHUB_TOKEN=

# Optional GitHub webhook. Configure the same random secret in GitHub and send
# push and pull_request events to /api/webhooks/github.
# GITHUB_WEBHOOK_SECRET=

# Optional GitNexus code intelligence. Install with `npm i -g gitnexus` or
# `mkdir -p .tools && (cd .tools && npm i gitnexus)`; GITNEXUS_BIN overrides the path.
# GITNEXUS_ENABLED=true
# GITNEXUS_MCP_PORT=3907

# Optional path to Google's OSV Scanner for dependency-vulnerability matching.
# Docker includes a pinned build; local runs also search PATH and .tools/.
# OSV_SCANNER_BIN=/usr/local/bin/osv-scanner
