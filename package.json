{
  "name": "codetend",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.28.0"
    }
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "preview": "vite preview",
    "preview:serve": "bash scripts/start-preview.sh --build",
    "typecheck": "tsc --noEmit",
    "check": "biome check . && bun run check:boundaries",
    "check:boundaries": "bun run scripts/check-import-boundaries.ts",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:deadcode": "knip",
    "test": "bun test",
    "test:database": "bun run scripts/database-smoke.ts",
    "verify": "bun run check && bun run test && bun run typecheck && bun run build && bun run eve:typecheck && bun run lint:deadcode",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "eve:install": "cd eve && npm install",
    "tools:osv-scanner": "bash scripts/install-osv-scanner.sh",
    "eve:build": "cd eve && npx eve build",
    "eve:start": "cd eve && npx eve start --host 127.0.0.1 --port 2000",
    "eve:dev": "cd eve && npx eve dev --no-ui --port 2000",
    "eve:typecheck": "cd eve && npx tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@jmondi/oauth2-server": "^5",
    "@modelcontextprotocol/server": "^2",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-router": "^1.170.36",
    "@tanstack/react-start": "^1.168.54",
    "ae-cvss-calculator": "1.0.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "drizzle-orm": "^0.45.2",
    "eve": "0.63.0",
    "jose": "^6",
    "lucide-react": "^1.46.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.36",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.35.1",
    "nitro": "^3.0.260903-beta",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
